{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/skillx/commit-local-changes/output.schema.json",
  "title": "CommitLocalChangesOutput",
  "description": "本地 Git commit 执行结果。",
  "type": "object",
  "additionalProperties": false,
  "required": ["commit", "summary"],
  "properties": {
    "commit": {
      "type": "string",
      "description": "提交后的 HEAD commit hash。"
    },
    "summary": {
      "type": "string",
      "description": "git commit 输出摘要。"
    },
    "statusBefore": {
      "type": "string",
      "description": "提交前的 git status --short 摘要，仅在 includeStatus 为 true 时返回。"
    }
  }
}
