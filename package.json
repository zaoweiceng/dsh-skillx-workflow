{
  "name": "dsh-skillx-workflow",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Native DSH agent workflow learning and progressive capability loading",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "README.md",
    "scripts/install.sh",
    "scripts/start.sh",
